{
  "name": "@paver/jev",
  "version": "0.1.1",
  "description": "Guarded client for TypeSafe AI's Jev (System One) via Vercel AI Gateway: typed questions and answers, never-throw typed failures, bounded retry, personal-data and size refusals, yes/no/unsure decisions.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22",
    "prepare": "pnpm run build",
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.2"
  }
}
