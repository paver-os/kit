{
  "name": "@paver/supabase",
  "version": "0.3.0",
  "description": "Shared Supabase client factories (browser/server/admin) + env-newline guard + SSR middleware helper for the Paver fleet.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/middleware.ts --format esm --dts --clean --target node22",
    "prepare": "pnpm run build",
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.5.0",
    "@supabase/supabase-js": ">=2.45.0",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^16.1.6",
    "tsup": "^8.3.0",
    "typescript": "^5.9.2"
  }
}
